+                        continue;
+                    }
+                    let r = linear_to_srgb((fix15::to_f32(p[0]) / a).clamp(0.0, 1.0));
+                    let g = linear_to_srgb((fix15::to_f32(p[1]) / a).clamp(0.0, 1.0));
+                    let b = linear_to_srgb((fix15::to_f32(p[2]) / a).clamp(0.0, 1.0));
+                    payload.push((r * 255.0).round().clamp(0.0, 255.0) as u8);
+                    payload.push((g * 255.0).round().clamp(0.0, 255.0) as u8);
+                    payload.push((b * 255.0).round().clamp(0.0, 255.0) as u8);
+                    payload.push((a * 255.0).round().clamp(0.0, 255.0) as u8);
