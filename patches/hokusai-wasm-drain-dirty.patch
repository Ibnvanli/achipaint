+    ///     u32 x0, u32 y0, u32 x1, u32 y1
+    ///                               world-space pixel rect, x1/y1 exclusive,
+    ///                               already clipped to [0,width)×[0,height)
+    /// then, in the same order, the pixels of each entry:
+    ///     (x1-x0) * (y1-y0) * 4 bytes, row-major, straight alpha
+    /// ```
