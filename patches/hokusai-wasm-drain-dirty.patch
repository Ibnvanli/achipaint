+            let y0 = (ty * ts).max(0);
+            let x1 = ((tx + 1) * ts).min(w);
+            let y1 = ((ty + 1) * ts).min(h);
+            if x1 <= x0 || y1 <= y0 {
+                continue;
+            }
+            entries.push((tx, ty, x0 as u32, y0 as u32, x1 as u32, y1 as u32));
+        }
+        if entries.is_empty() {
+            return Vec::new();
+        }
+
+        let mut payload: Vec<u8> = Vec::new();
+        for &(tx, ty, x0, y0, x1, y1) in &entries {
+            let rect = ((x1 - x0) * (y1 - y0) * 4) as usize;
+            let Some(tile) = self.surface.tile(tx, ty) else {
+                payload.resize(payload.len() + rect, 0);
+                continue;
